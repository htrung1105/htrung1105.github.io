---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site';
---
<PageLayout title="Certificates & Awards — Nguyen Le Hoang Trung" description="Competition awards and certifications of Nguyen Le Hoang Trung.">
  <h1 class="page-title">Certificates &amp; Awards</h1>
  <p class="lede">Competition results and course certifications.</p>

  <section>
    <h2 class="eyebrow">awards</h2>
    <ul class="grid">
      {site.awards.map((a) => (
        <li class="card item">
          <b>{a.title}</b>
          <span class="org">{a.org}</span>
          {a.note && <span class="note">{a.note}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="eyebrow">certifications</h2>
    <ul class="grid">
      {site.certifications.map((c) => (
        <li class="card item">
          <b>{c.url ? <a href={c.url}>{c.title}</a> : c.title}</b>
          <span class="org">{c.issuer}{c.year && ` · ${c.year}`}</span>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  section { margin-bottom: var(--space-7); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .item { padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: 2px; }
  .item b { font-size: 16px; letter-spacing: -0.01em; }
  .item b a { color: var(--text); }
  .org { font-size: 14px; color: var(--accent); }
  .note { font-size: 13.5px; color: var(--text-muted); }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
