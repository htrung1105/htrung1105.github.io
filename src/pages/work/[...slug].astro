---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import { tagSlug } from '../../lib/tags';
import '../../styles/prose.css';

interface Props { project: CollectionEntry<'projects'>; }

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const { title, role, period, summary, repo, demo, paper, tags, metrics, cover, coverAlt } = project.data;
---
<PageLayout title={`${title} | Trung Nguyen - Portfolio`} description={summary}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">›</span><a href="/work">Projects</a><span aria-hidden="true">›</span><span aria-current="page">{title}</span>
  </nav>

  <header class="head">
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    <p class="meta">{period} · {role}</p>
    <ul class="tags">{tags.map((tag) => <li><a class="tag" href={`/tags/${tagSlug(tag)}`}>{tag}</a></li>)}</ul>
    <div class="links">
      {repo && <a class="btn" href={repo}>View repository</a>}
      {paper && <a class="btn" href={paper}>Read the paper</a>}
      {demo && <a class="btn" href={demo}>Live demo</a>}
    </div>
  </header>

  {cover && <Image src={cover} alt={coverAlt ?? ''} width={960} height={400} class="card banner" loading="eager" />}

  {metrics.length > 0 && (
    <ul class="metrics">
      {metrics.map((m) => (
        <li class="card"><b>{m.value}</b><span>{m.label}</span></li>
      ))}
    </ul>
  )}

  <article class="prose"><Content /></article>
</PageLayout>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: 13px; color: var(--text-muted); }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--text); }
  .head { text-align: center; margin: var(--space-7) auto var(--space-6); max-width: 720px; }
  h1 { margin: 0; font-size: clamp(28px, 5.5vw, 42px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.15; }
  .summary { margin: var(--space-4) 0 0; color: var(--text-muted); }
  .meta { margin: var(--space-3) 0; font-size: 13px; color: var(--text-muted); font-family: var(--font-mono); }
  .tags { justify-content: center; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-5); }
  .banner { display: block; width: 100%; aspect-ratio: 12 / 5; object-fit: cover; padding: 0; overflow: hidden; }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
  }
  .metrics li { padding: var(--space-3) var(--space-4); }
  .metrics b { display: block; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--accent); }
  .metrics span { font-size: 12.5px; color: var(--text-muted); }
  .prose { margin: var(--space-6) auto 0; }
</style>
