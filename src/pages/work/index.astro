---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import TagFilter from '../../components/TagFilter.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---
<PageLayout title="Projects — Nguyen Le Hoang Trung" description="Projects in information retrieval, GraphRAG, multimodal video retrieval and OCR.">
  <h1 class="page-title">Projects</h1>
  <p class="lede">Retrieval, GraphRAG, multimodal video search and document OCR. All team projects; each page says what I built.</p>

  <TagFilter tags={tags.map((tag) => ({ value: tag, label: tag }))} />

  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</PageLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
