---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../config/site';
import portrait from '../assets/portrait.jpg';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const latest = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

// Brand marks from Simple Icons (CC0).
const socials = [
  {
    label: 'GitHub',
    href: site.github,
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'LinkedIn',
    href: site.linkedin,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'Facebook',
    href: site.facebook,
    icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
];
---
<PageLayout title="Trung Nguyen - Portfolio" description={site.blurb}>
  <div class="bento">
    <section class="card hero" aria-labelledby="hi">
      <h1 id="hi">{site.name}</h1>
      <p class="role">{site.role} · HCMC · Multimodal Agentic RAG &amp; LLM &amp; AI systems</p>
      <p class="blurb">{site.blurb}</p>
      <p class="status"><span>Status:</span> {site.status}</p>
      <div class="hero-foot">
        <div class="cta">
          <a class="btn" href="/resume">View Résumé</a>
          <a class="btn primary" href="/files/resume.pdf" download>Download CV</a>
        </div>
      </div>
    </section>

    <aside class="card profile" aria-label="Contact">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={260} height={260} class="portrait" loading="eager" fetchpriority="high" />
      <div class="contact-info">
        <ul class="socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me" aria-label={s.label} title={s.label}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.icon} /></svg>
              </a>
            </li>
          ))}
        </ul>
        <dl class="info">
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </dl>
      </div>
    </aside>
  </div>

  <section>
    <h2 class="eyebrow">projects</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section>
    <h2 class="eyebrow">publication</h2>
    {publications.map((pub) => (
      <article class="card pub">
        <h3><a href="/publications">{pub.data.title}</a></h3>
        <p class="muted">{pub.data.authors.join(', ')}</p>
        <p class="muted">{pub.data.venue}{pub.data.award && <> · <span class="award">{pub.data.award}</span></>}</p>
        {pub.data.pdf && <a class="btn" href={pub.data.pdf}>Paper (DOI)</a>}
      </article>
    ))}
  </section>

  <div class="two">
    <section>
      <h2 class="eyebrow">awards</h2>
      <ul class="card list">
        {site.awards.map((a) => (
          <li>
            <b>{a.title}</b> — {a.org}
            {a.note && <span class="muted block">{a.note}</span>}
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2 class="eyebrow">education</h2>
      <div class="card list edu">
        <div class="school">
          <b>University of Science, VNU-HCM</b>
          <span class="muted block">B.Sc. in Artificial Intelligence · 2023 – 2027 (expected)</span>
          <span class="muted block">GPA 7.74 / 10.0</span>
        </div>
        <div class="school">
          <b>Quang Trung High School for the Gifted</b>
          <span class="muted block">Mathematics-Informatics Class · National Informatics Team · 2020 – 2023</span>
          <span class="muted block">GPA 9.50 / 10</span>
        </div>
        <p class="muted">Certifications: English B2 (VSTEP) · DeepLearning.AI (2026): Agentic AI, Data Analytics Foundations, Linear Algebra for ML.</p>
      </div>
    </section>
  </div>

  <section>
    <h2 class="eyebrow">timeline</h2>
    <ol class="timeline">
      {site.timeline.map((t) => (
        <li>
          <time>{t.date}</time>
          {'href' in t ? <a href={t.href}>{t.text}</a> : <span>{t.text}</span>}
        </li>
      ))}
    </ol>
  </section>

  {latest.length > 0 && (
    <section>
      <h2 class="eyebrow">recent posts</h2>
      <ul class="posts">
        {latest.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>

<style>
  section { margin-bottom: var(--space-7); }
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .hero { padding: var(--space-6); margin: 0; display: flex; flex-direction: column; }
  h1 {
    margin: 0;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .role { margin: var(--space-2) 0 0; font-size: 14px; color: var(--accent); font-family: var(--font-mono); }
  .blurb { max-width: 60ch; margin: var(--space-4) 0 0; color: var(--text-muted); }
  /* pinned to the card bottom so the hero fills the height of the profile card */
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .status { margin: var(--space-4) 0 var(--space-5); font-weight: 700; color: var(--text); }
  .status span { color: var(--accent); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-left: auto; }

  .profile { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-3); }
  .portrait { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; border-radius: var(--radius-md); }
  .contact-info { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .socials { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-2); }
  .socials a {
    display: grid;
    place-items: center;
    height: 36px;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s, color 0.2s;
  }
  .socials a:hover { border-color: var(--accent); color: var(--accent); }
  .info { margin: 0; padding-top: var(--space-3); border-top: 1px solid var(--border); font-size: 13px; }
  .info dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .info dt::after { content: ':'; }
  .info dd { margin: 2px 0 var(--space-2); color: var(--text); }
  .info dd:last-child { margin-bottom: 0; }
  /* keep the address on one line; 12px fits the 260px card */
  .info a { color: var(--text); text-decoration: none; font-weight: 500; font-size: 12px; white-space: nowrap; }
  .info a:hover { color: var(--accent); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }

  .pub { padding: var(--space-5); }
  .pub h3 { margin: 0 0 var(--space-2); font-size: 17px; letter-spacing: -0.01em; }
  .pub h3 a { color: var(--text); text-decoration: none; }
  .pub h3 a:hover { color: var(--accent); }
  .pub p { margin: 0 0 var(--space-1); font-size: 14px; }
  .pub .btn { margin-top: var(--space-3); }
  .award { color: var(--accent); font-weight: 600; }

  .muted { color: var(--text-muted); }
  .block { display: block; font-size: 13.5px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .list { list-style: none; margin: 0; padding: var(--space-4) var(--space-5); font-size: 14.5px; }
  .list li + li { margin-top: var(--space-3); }
  .edu p { margin: var(--space-3) 0 0; font-size: 13.5px; }
  .school + .school { margin-top: var(--space-3); }

  .timeline { list-style: none; margin: 0; padding: 0 0 0 var(--space-5); border-left: 1px solid var(--border-strong); }
  .timeline li { position: relative; display: flex; gap: var(--space-4); padding: var(--space-2) 0; font-size: 14.5px; }
  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) - 5px);
    top: 15px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline time { flex: none; width: 72px; font-family: var(--font-mono); font-size: 12.5px; color: var(--text-muted); padding-top: 2px; }
  .timeline a { color: var(--text); text-decoration: none; }
  .timeline a:hover { color: var(--accent); }

  .posts { list-style: none; margin: 0; padding: 0; }
  .posts li { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
  .posts a { font-weight: 600; text-decoration: none; color: var(--text); }
  .posts a:hover { color: var(--accent); }
  .posts time { flex: none; font-size: 13px; color: var(--text-muted); font-family: var(--font-mono); }

  @media (max-width: 760px) {
    .bento { grid-template-columns: 1fr; }
    .hero { padding: var(--space-5); }
    /* portrait + icons on one row, email full width below so it never wraps */
    .profile { display: grid; grid-template-columns: 96px 1fr; align-items: center; }
    .portrait { width: 96px; }
    .contact-info { display: contents; }
    .info { grid-column: 1 / -1; }
    .grid, .two { grid-template-columns: 1fr; }
    .timeline li { flex-direction: column; gap: 0; }
  }
</style>
