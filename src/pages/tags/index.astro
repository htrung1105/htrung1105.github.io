---
import PageLayout from '../../layouts/PageLayout.astro';
import { getTags } from '../../lib/tags';

const tags = await getTags();
---
<PageLayout title="Tags — Nguyen Le Hoang Trung" description="Projects and posts grouped by topic.">
  <h1 class="page-title">Tags</h1>
  <p class="lede">Projects and posts grouped by topic.</p>

  <ul class="cloud">
    {tags.map((t) => (
      <li><a class="tag" href={`/tags/${t.slug}`}>{t.name} <span>{t.count}</span></a></li>
    ))}
  </ul>
</PageLayout>

<style>
  .cloud { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cloud .tag { font-size: 14px; padding: 6px 12px; }
  .cloud span { margin-left: var(--space-1); color: var(--accent); }
</style>
