---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import portrait from '../assets/portrait.jpg';

const githubUrl = new URL(site.github);
const githubLabel = githubUrl.host + githubUrl.pathname;
---
<aside class="card profile">
  <Image src={portrait} alt={`Portrait of ${site.name}`} width={96} height={96} class="portrait" />
  <h2 class="name">{site.name}</h2>
  <p class="role">{site.role}</p>

  <ul class="contacts">
    <li>
      <span class="ico" aria-hidden="true">@</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </li>
    <li>
      <span class="ico" aria-hidden="true">gh</span>
      <a href={site.github} rel="me">{githubLabel}</a>
    </li>
    <li>
      <span class="ico" aria-hidden="true">in</span>
      <a href={site.linkedin} rel="me">LinkedIn</a>
    </li>
    <li>
      <span class="ico" aria-hidden="true">◎</span>
      <span>{site.location}</span>
    </li>
  </ul>

  <a class="cta" href="/resume">View résumé</a>
</aside>

<style>
  .profile {
    padding: var(--space-5);
    position: sticky;
    top: var(--space-5);
  }
  .portrait {
    border-radius: var(--radius-md);
    object-fit: cover;
    margin-bottom: var(--space-4);
  }
  .name {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .role {
    display: inline-block;
    margin: var(--space-2) 0 0;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
  }
  .contacts {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }
  .contacts li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
  .ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 6px;
  }
  .cta {
    display: block;
    margin-top: var(--space-4);
    padding: 9px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  :global(:root[data-theme='dark']) .cta { color: #0d1117; }

  @media (max-width: 860px) {
    .profile { position: static; }
  }
</style>
