---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { tagSlug } from '../lib/tags';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, role, period, summary, tags, cover, coverAlt } = project.data;
---
<article class="card lift project" data-tags={tags.join(',')}>
  {cover && <Image src={cover} alt={coverAlt ?? ''} width={600} height={250} class="banner" />}
  <div class="body">
    <h3 class="title-h"><a href={`/work/${project.id}`} class="title">{title}</a></h3>
    <p class="meta">{period} · {role}</p>
    <p class="summary">{summary}</p>
    <ul class="tags">{tags.map((tag) => <li><a class="tag" href={`/tags/${tagSlug(tag)}`}>{tag}</a></li>)}</ul>
  </div>
</article>

<style>
  .project { position: relative; overflow: hidden; display: flex; flex-direction: column; }
  .project[hidden] { display: none; }
  .banner { display: block; width: 100%; aspect-ratio: 12 / 5; object-fit: cover; border-bottom: 1px solid var(--border); }
  .body { padding: var(--space-4) var(--space-5) var(--space-5); display: flex; flex-direction: column; flex: 1; }
  .title-h { margin: 0; font-size: inherit; font-weight: inherit; }
  .title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--text);
  }
  /* whole card is clickable via the title link */
  .title::after { content: ''; position: absolute; inset: 0; }
  .project:hover .title { color: var(--accent); }
  .meta { margin: 2px 0 var(--space-3); font-size: 12.5px; color: var(--text-muted); font-family: var(--font-mono); }
  .summary { margin: 0 0 var(--space-4); font-size: 14.5px; color: var(--text-muted); flex: 1; }
  /* tag links sit above the card-wide title link */
  .tags { position: relative; z-index: 1; }
</style>
