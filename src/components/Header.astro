---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import portrait from '../assets/portrait.jpg';

const links = [
  { href: '/work', label: 'Projects' },
  { href: '/publications', label: 'Publications' },
  { href: '/resume', label: 'CV' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header>
  <div class="container bar">
    <a class="brand" href="/" aria-label="Home">
      <Image src={portrait} alt="" width={56} height={56} class="avatar" loading="eager" />
      <span>htrung1105</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'on' : ''} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 58px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--text);
    flex: none;
  }
  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }
  nav { flex: 1; overflow-x: auto; scrollbar-width: none; }
  ul {
    display: flex;
    justify-content: flex-end;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 6px 10px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  ul a:hover { color: var(--text); }
  ul a.on { color: var(--text); background: var(--accent-soft); }

  @media (max-width: 640px) {
    .bar { flex-wrap: wrap; height: auto; padding-top: var(--space-2); padding-bottom: var(--space-1); justify-content: space-between; }
    nav { order: 3; flex-basis: 100%; }
    ul { justify-content: space-between; }
    ul a { padding: 6px 8px; font-size: 13px; }
  }
</style>
