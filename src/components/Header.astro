---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Dashboard' },
  { href: '/work', label: 'Projects' },
  { href: '/publications', label: 'Publications' },
  { href: '/resume', label: 'CV' },
  { href: '/blog', label: 'Blog' },
  { href: '/certificates', label: 'Certificates' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header>
  <div class="container bar">
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'on' : ''} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 58px;
  }
  nav { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  ul {
    display: flex;
    justify-content: flex-end;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 6px 10px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  ul a:hover { color: var(--text); }
  ul a.on { color: var(--text); background: var(--accent-soft); }

  @media (max-width: 640px) {
    .bar { gap: var(--space-2); height: auto; padding-top: var(--space-2); padding-bottom: var(--space-2); }
    ul { flex-wrap: wrap; }
    ul a { padding: 5px 7px; font-size: 13px; }
  }
</style>
